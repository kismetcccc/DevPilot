# DevPilot 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
DEVPILOT_HOST=127.0.0.1
DEVPILOT_PORT=7437

# ── Logging ───────────────────────────────────────────────────
DEVPILOT_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
DEVPILOT_LOG_FILE=~/.devpilot/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
DEVPILOT_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# DEVPILOT_CONFIG=~/.devpilot/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# DEVPILOT_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# DEVPILOT_MAX_STEPS=20

# GLM / OpenAI 兼容接口：启用后优先于 Anthropic
# MODEL_NAME 优先于 DEVPILOT_LLM_DEFAULT_MODEL，填写智谱平台密钥
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL_NAME=glm-4.7-flash
OPENAI_API_KEY=
