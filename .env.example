# DevPilot 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
DEVPILOT_HOST=127.0.0.1
DEVPILOT_PORT=7437

# ── Logging ───────────────────────────────────────────────────
DEVPILOT_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
DEVPILOT_LOG_FILE=~/.devpilot/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
DEVPILOT_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# DEVPILOT_CONFIG=~/.devpilot/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# DEVPILOT_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# DEVPILOT_MAX_STEPS=20

# GLM / OpenAI 兼容接口：启用后优先于 Anthropic
# MODEL_NAME 优先于 DEVPILOT_LLM_DEFAULT_MODEL，填写智谱平台密钥
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL_NAME=glm-4.7-flash
OPENAI_API_KEY=

# ── PostgreSQL Memory ─────────────────────────────────────────
# 未配置 DSN 时保留旧文件笔记模式；配置后画像和新短期笔记使用 PostgreSQL
# Compose 启动：先设置下方密码，再运行 docker compose up -d
# DEVPILOT_POSTGRES_PASSWORD=替换为本地数据库密码
# DEVPILOT_POSTGRES_PORT=55432
# DEVPILOT_MEMORY_DSN=postgresql://devpilot:替换为本地数据库密码@127.0.0.1:55432/devpilot
# 同一用户在不同项目应保持相同标识，不同用户必须使用不同标识
# DEVPILOT_MEMORY_USER_ID=default
# 短期笔记有效期（小时），不会因重放旧笔记自动续期
# DEVPILOT_MEMORY_TTL_HOURS=24
# DEVPILOT_MEMORY_CONTEXT_MAX_CHARS=6000
# DEVPILOT_MEMORY_POOL_MAX_SIZE=4
# 每轮额外进行一次无工具的画像提取调用；false 时仅通过 /memory 主动管理画像
# DEVPILOT_MEMORY_AUTO_EXTRACT=true
